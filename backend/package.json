{
  "name": "contacts-app-backend",
  "version": "1.0.0",
  "description": "Backend para aplicação de contatos com Express e Prisma",
  "main": "src/index.ts",
  "scripts": {
    "dev": "npm run migrate:seed && ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "ts-node src/index.ts",
    "prisma:generate": "npx prisma generate --no-engine",
    "migrate:seed": "npx prisma migrate dev --name init && npm run prisma:generate",
    "seed": "ts-node prisma/seed.ts",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "prisma",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.17.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "contacts-app-fullstack": "file:..",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "prisma": "^6.17.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "vitest": "^2.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "npm run seed"
  }
}
